# CLACKFORGE server - env vars (copy to .env, never commit the real file)
#
# Loaded via Node's native `--env-file-if-exists=.env` flag (see package.json
# dev/start scripts) - no dotenv dependency needed. On Render there is no
# .env file at all; real values come from the dashboard's env var UI.

# Postgres connection string. Works with any Postgres, including Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/clackforge?schema=public"

# Supabase: Project > Connect > "Session pooler" (port 5432). Use the session
# pooler, not the direct `db.<ref>.supabase.co` host (IPv6-only on the free
# plan, so it fails on most home networks) and not the transaction pooler
# (port 6543), which breaks Prisma migrations and prepared statements. The
# same URL is used by Prisma and by the session store (`pg`), so no code
# changes or extra DIRECT_URL are needed. Example shape:
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# express-session signing secret. Generate a real random value per
# environment (e.g. `openssl rand -base64 32`) - never reuse the local dev
# value in production.
SESSION_SECRET="changeme-local-dev-only-generate-a-real-32-byte-secret"

# Origin of the client app, for CORS + the session cookie's cross-origin
# behavior (see server/src/app.ts). Local dev default matches Vite's
# default port; set to the deployed static site's URL on Render.
CLIENT_ORIGIN="http://localhost:5173"

# Reverse proxies in front of Express (affects req.ip and secure cookies).
# Leave at 1 locally. render.yaml sets 2 in production.
# TRUST_PROXY_HOPS=1

# Google OAuth (Passport) - optional for local dev.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Stripe TEST MODE keys. Get these from the Stripe dashboard (Developers >
# API keys, with "Test mode" toggled ON - never use live keys in this app).
# STRIPE_SECRET_KEY is the "Secret key" (starts sk_test_...). Without it,
# POST /api/checkout/session fails closed with 500 instead of crashing.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create
# (Developers > Webhooks > Add endpoint, URL: <your server>/api/webhooks/stripe,
# event: checkout.session.completed) or from `stripe listen` for local dev.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend API key - order confirmation emails. Get one free at resend.com.
# Without it, confirmation emails log their subject+body to the console
# instead of sending.
# RESEND_API_KEY=

PORT=3000
NODE_ENV=development
